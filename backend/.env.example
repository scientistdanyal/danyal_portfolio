# Environment variables declared in this file are NOT automatically loaded by Prisma.
# prisma.config.ts loads them via dotenv.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio?schema=public"
PORT=4000
NODE_ENV="development"
FRONTEND_ORIGIN="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,https://engineerdanyal.com,https://www.engineerdanyal.com"
JWT_SECRET="change-me-in-production"
ADMIN_EMAIL="admin@engineerdanyal.com"
ADMIN_PASSWORD="change-me"
# Required in production; optional in development (admin routes open if unset)
ADMIN_API_KEY="dev-admin-key-change-me"
TRUST_PROXY="false"
