# Production environment for Vultr VPS / Docker Compose
# Copy to repo root as `.env` on the server:
#   cp .env.production.example .env
# Then replace every CHANGE_ME value.

NODE_ENV=production
TRUST_PROXY=true

# Postgres (Docker service `db` — not exposed publicly)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=portfolio

# Host ports bound to 127.0.0.1 only (Nginx proxies to these)
BACKEND_PORT=4000
FRONTEND_PORT=3000
PORT=4000

# Compose overrides DATABASE_URL to use host `db`; keep this in sync for clarity
DATABASE_URL=postgresql://portfolio:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/portfolio?schema=public

# Public site / CORS
FRONTEND_ORIGIN=https://engineerdanyal.com
ALLOWED_ORIGINS=https://engineerdanyal.com,https://www.engineerdanyal.com

# Browser-facing API base (baked into Next.js at build time)
NEXT_PUBLIC_API_URL=https://api.engineerdanyal.com

# Auth — use long random strings (e.g. openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
ADMIN_EMAIL=admin@engineerdanyal.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
