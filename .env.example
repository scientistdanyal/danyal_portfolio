# Local / shared defaults (development)
NODE_ENV=development

# Postgres (docker-compose.dev.yml)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio
POSTGRES_PORT=5432

# Backend
PORT=4000
BACKEND_PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio?schema=public
FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://engineerdanyal.com,https://www.engineerdanyal.com
JWT_SECRET=change-me-in-production-min-16
ADMIN_EMAIL=admin@engineerdanyal.com
ADMIN_PASSWORD=change-me
ADMIN_API_KEY=dev-admin-key-change-me
TRUST_PROXY=false

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Production ---
# On the VPS use `.env.production.example` → `.env` instead of this file.
# See deploy/DEPLOY.md
